# Copy this file to .env.development or .env.production and fill in the values.
# Never commit actual .env files — they are git-ignored.

# Backend API base URL (include /api/v1)
# Development: https://localhost:7022/api/v1
# Production:  http://172.16.16.40:5001/api/v1
VITE_BACKEND_ORIGIN=http://<host>:<port>/api/v1
VITE_API_URL=http://<host>:<port>/api/v1
